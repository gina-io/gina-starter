// Couchbase connector for the Docker Compose stack (the couchbase profile). Gina does
// not read this file where it is: copy it over src/demo/config/connectors.json to use
// it (see the README).
// The entry is named after its bucket, demo: under another name the bundle stops at
// boot, unable to read src/demo/models/demo/entities. Host, bucket and user are the
// ones the compose file creates; the password comes from CB_PASS (docker-compose.yml)
// through ${secret:CB_PASS}, the placeholder form Gina fills in from the environment.
{
  "$schema": "https://gina.io/schema/connectors.json",
  "demo": {
    "connector"    : "couchbase",
    "protocol"     : "couchbase://",
    "host"         : "couchbase",
    "database"     : "demo",
    "username"     : "appuser",
    "password"     : "${secret:CB_PASS}",
    "pingInterval" : "2m"
  }
}
