// Couchbase connector for the Docker Compose stack. Gina does not read this file
// where it is: copy it over src/demo/config/connectors.json to use it (see the README).
// Connects to the Couchbase container on the Docker network.
// Host values come from environment variables set in docker-compose.yml.
{
  "$schema": "https://gina.io/schema/connectors.json",
  "couchbase": {
    "protocol" : "couchbase://",
    "host"     : "${CB_HOST}",
    "database" : "${CB_BUCKET}",
    "username" : "${CB_USER}",
    "password" : "${CB_PASS}",
    "ping"     : "2m"
  }
}
