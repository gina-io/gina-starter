// bundle needs to be restarted on changes !!
// Declare database connections available to this bundle's models.
// See: https://gina.io/docs/reference/connectors
//
// Example (name the entry after its bucket, and add the SDK: npm install couchbase@^4):
// "demo": {
//   "connector"    : "couchbase",
//   "protocol"     : "couchbase://",
//   "host"         : "127.0.0.1",
//   "database"     : "demo",
//   "username"     : "appuser",
//   "password"     : "secret",
//   "pingInterval" : "2m"
// }
//
// For local overrides without touching this file:
//   create connectors.dev.json alongside this file
//   and declare only the keys you want to override.
{
  "$schema": "https://gina.io/schema/connectors.json"
}
